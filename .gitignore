.venv/
.cache/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store
.idea/
build/
dist/
*.py[cod]

# Keep metadata, but ignore raw payloads with ANY filename / extension.
/data/raw/**
!/data/raw/**/
!/data/raw/**/metadata.yaml
!/data/raw/.gitkeep

# This small fixture must be available after cloning.
!/data/raw/_toy_binary/data.csv
!/data/raw/_toy_binary/metadata.yaml

/data/processed/**
!/data/processed/.gitkeep
/data/splits/**
!/data/splits/.gitkeep
/data/derived/**
!/data/derived/meta_features/
!/data/derived/landmarkers/
!/data/derived/candidate_scores/
!/data/derived/meta_features/.gitkeep
!/data/derived/landmarkers/.gitkeep
!/data/derived/candidate_scores/.gitkeep
/results/**
!/results/tables/
!/results/figures/
!/results/logs/
!/results/tables/.gitkeep
!/results/figures/.gitkeep
!/results/logs/.gitkeep
